---
interface Props {
  currentPage?: string;
}
const { currentPage } = Astro.props;
const navItems = [
  { label: 'Blog', href: '/blog/' },
  { label: 'Projects', href: '/projects/' },
  { label: 'Teaching', href: '/teaching/' },
  { label: 'Musings', href: '/musings/' },
];
---

<header class="site-header">
  <a href="/" class="brand">Karthikeshwar</a>
  <nav>
    <ul class="nav-menu">
      {navItems.map((item, i) => (
        <>
          <li class="nav-item">
            <a
              href={item.href}
              class={currentPage === item.label.toLowerCase() ? 'active' : ''}
            >
              {item.label}
            </a>
          </li>
          {i < navItems.length - 1 && <li class="nav-sep">/</li>}
        </>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(230, 227, 220, 0.6);
  }

  .brand {
    font-size: 1.05rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    transition: opacity 0.3s ease;
  }

  .brand:hover {
    opacity: 0.7;
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    list-style: none;
  }

  .nav-item a {
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-secondary);
    position: relative;
    padding: 0.25rem 0;
    transition: color 0.3s ease;
  }

  .nav-item a:hover,
  .nav-item a.active {
    color: var(--ink);
  }

  .nav-item a::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: var(--ink);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s cubic-bezier(0.2, 0, 0, 1);
  }

  .nav-item a:hover::after,
  .nav-item a.active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav-sep {
    color: var(--border-subtle);
    font-size: 0.75rem;
    user-select: none;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .site-header {
      flex-direction: column;
      gap: 1rem;
      align-items: center;
      text-align: center;
    }

    .nav-menu {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.75rem 1rem;
    }

    .nav-sep {
      display: none;
    }
  }
</style>
