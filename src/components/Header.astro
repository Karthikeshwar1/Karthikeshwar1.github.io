---
import T from './T.astro';
import { NAME, ui } from '../lib/i18n';

interface Props {
  currentPage?: string;
}
const { currentPage } = Astro.props;
const navItems = [
  { label: NAME, href: '/', page: 'home' },
  { label: ui.nav.blog, href: '/blog/', page: 'blog' },
  { label: ui.nav.projects, href: '/projects/', page: 'projects' },
  { label: ui.nav.musings, href: '/musings/', page: 'musings' },
];
---

<header class="site-header">
  <nav aria-label="Site">
    <ul class="pipes nav">
      {navItems.map((item) => (
        <li>
          <a href={item.href} aria-current={currentPage === item.page ? 'page' : undefined}>
            <T t={item.label} />
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    width: 100%;
    padding-top: clamp(1.75rem, 6svh, 3.25rem);
  }

  .nav {
    --pipe-gap: 1.1em;
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-variant-numeric: lining-nums;
    color: var(--ink);
  }

  .nav a {
    color: var(--ink);
  }

  /* Kannada has no uppercase; 1.14em optically balances Garamond's all-caps cap height. */
  .nav :global([lang="kn"]) {
    font-size: 1.14em;
  }

  .nav a:hover,
  .nav a[aria-current="page"]:not([href="/"]) {
    text-decoration: underline;
  }

  /* The name takes its own line; the three rooms sit beneath it. */
  @media (max-width: 720px) {
    .nav {
      --pipe-gap: 0.75em;
      font-size: 0.82rem;
      row-gap: 0.85rem;
    }

    .nav > li:first-child {
      flex-basis: 100%;
      justify-content: center;
      font-size: 1.12em;
    }

    .nav > li:nth-child(2)::before {
      display: none;
    }
  }
</style>
