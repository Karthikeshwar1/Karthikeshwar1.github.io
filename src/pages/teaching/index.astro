---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Teaching — Karthikeshwar" currentPage="teaching">
  <main class="page-content">
    <h1 class="page-title">Teaching</h1>

    <section class="teaching-section">
      <h2>Lectures on YouTube</h2>
      <ul class="teaching-list">
        <li>
          <a href="https://www.youtube.com/playlist?list=PL7pX5D24QuQEPkXet6aTOtgRnnjNKICCp" target="_blank" rel="noopener">
            Deep Learning
          </a>
        </li>
        <li>
          <a href="https://youtube.com/playlist?list=PL7pX5D24QuQFOSw5b4RHwvaK7Y25X-ofm" target="_blank" rel="noopener">
            Algorithms and Data Structures
          </a>
        </li>
        <li>
          <a href="https://www.youtube.com/playlist?list=PL7pX5D24QuQHLoowEWAPP6P5YHPV6mirv" target="_blank" rel="noopener">
            Physics
          </a>
        </li>
        <li>
          <a href="https://www.youtube.com/playlist?list=PL7pX5D24QuQFLeF-c31WMzuW0qNUep_BB" target="_blank" rel="noopener">
            Logic
          </a>
        </li>
        <li>
          <a href="https://www.youtube.com/playlist?list=PL7pX5D24QuQG4eiMmMEgowPlmogUf5oxL" target="_blank" rel="noopener">
            The Big Data
          </a>
        </li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .page-content {
    flex: 1;
    width: 100%;
    max-width: 780px;
    margin: 0 auto;
    padding: 3rem 2rem;
  }

  .page-title {
    font-size: 1.6rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    margin-bottom: 2.5rem;
    color: var(--ink);
  }

  .teaching-section h2 {
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-secondary);
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .teaching-list {
    list-style: none;
    padding: 0;
  }

  .teaching-list li {
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .teaching-list li:last-child {
    border-bottom: none;
  }

  .teaching-list a {
    font-size: 1.1rem;
    color: var(--ink);
    font-weight: 400;
    transition: color 0.3s ease;
  }

  .teaching-list a:hover {
    color: var(--ink-secondary);
  }

  @media (prefers-reduced-motion: no-preference) {
    .page-content {
      animation: fadeIn 0.8s ease-out 0.1s both;
    }
  }

  @media (max-width: 768px) {
    .page-content {
      padding: 2rem 1.25rem;
    }

    .page-title {
      font-size: 1.35rem;
    }
  }
</style>
