---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import alegalu from '../../assets/art/alegalu.jpg';
import T from '../../components/T.astro';
import { attr, pageTitle, ui } from '../../lib/i18n';

const playlists = [
  { title: 'Deep Learning', href: 'https://www.youtube.com/playlist?list=PL7pX5D24QuQEPkXet6aTOtgRnnjNKICCp' },
  { title: 'Algorithms and Data Structures', href: 'https://youtube.com/playlist?list=PL7pX5D24QuQFOSw5b4RHwvaK7Y25X-ofm' },
  { title: 'Physics', href: 'https://www.youtube.com/playlist?list=PL7pX5D24QuQHLoowEWAPP6P5YHPV6mirv' },
  { title: 'Logic', href: 'https://www.youtube.com/playlist?list=PL7pX5D24QuQFLeF-c31WMzuW0qNUep_BB' },
  { title: 'The Big Data', href: 'https://www.youtube.com/playlist?list=PL7pX5D24QuQG4eiMmMEgowPlmogUf5oxL' },
];
---

<BaseLayout
  title={pageTitle(ui.nav.musings)}
  description="Karthikeshwar's paintings, piano recordings, Kannada verse, and lectures."
  currentPage="musings"
>
  <main id="main" class="archive">
    <aside class="archive-aside">
      <h1 class="archive-title"><T t={ui.nav.musings} /></h1>
      <p class="archive-lede"><T t={ui.musings.lede} /></p>
      <div class="archive-count">
        <nav {...attr('aria-label', ui.nav.musings)}>
          <ul class="jump-list">
            <li><a href="#painting"><T t={ui.musings.painting} /></a></li>
            <li><a href="#piano"><T t={ui.musings.piano} /></a></li>
            <li><a href="#teaching"><T t={ui.musings.teaching} /></a></li>
          </ul>
        </nav>
      </div>
    </aside>

    <div class="archive-body">
      <section class="archive-section" id="painting" aria-labelledby="painting-heading">
        <h2 class="section-heading" id="painting-heading"><T t={ui.musings.painting} /></h2>
        <a class="work" href="/musings/Alegalhu">
          <span class="frame">
            <Image
              src={alegalu}
              {...attr('alt', ui.common.paintingAlt)}
              widths={[480, 760, 1100]}
              sizes="(max-width: 768px) 76vw, 23rem"
              quality={82}
            />
          </span>
          <span class="work-caption">
            <span class="work-title"><T t={ui.common.painting} /></span>
            <span class="label"><T t={ui.common.medium} /></span>
          </span>
        </a>
      </section>

      <section class="archive-section" id="piano" aria-labelledby="piano-heading">
        <h2 class="section-heading" id="piano-heading"><T t={ui.musings.piano} /></h2>
        <ul class="ledger">
          <li>
            <a class="ledger-row recording" href="https://www.youtube.com/playlist?list=PL7pX5D24QuQHfJUVwyLf3FpcOP5QdJJtF">
              <span class="ledger-title"><T t={ui.musings.recordings} /></span>
              <span class="ledger-meta"><T t={ui.musings.youtubePlaylist} /></span>
            </a>
          </li>
        </ul>
      </section>

      <section class="archive-section" id="teaching" aria-labelledby="teaching-heading">
        <h2 class="section-heading" id="teaching-heading"><T t={ui.musings.teaching} /></h2>
        <ul class="ledger">
          {playlists.map((p) => (
            <li>
              <a class="ledger-row recording" href={p.href}>
                <span class="ledger-title" lang="en">{p.title}</span>
                <span class="ledger-meta"><T t={ui.musings.playlist} /></span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .work {
    --art-h: calc(min(30rem, 100vw - 2.5rem) / 1.882);
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    width: fit-content;
    padding-top: 2.25rem;
  }

  .work-caption {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .work-title {
    font-size: 1.35rem;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: transparent;
  }

  .work:hover .work-title {
    text-decoration-color: currentColor;
  }

  .recording {
    padding: 1.35rem 0;
  }

  .recording .ledger-title {
    font-size: 1.6rem;
    line-height: 1.2;
    color: var(--ink);
  }

  @media (max-width: 768px) {
    .work {
      padding-top: 1.5rem;
    }

    .recording .ledger-title {
      font-size: 1.35rem;
    }
  }
</style>
