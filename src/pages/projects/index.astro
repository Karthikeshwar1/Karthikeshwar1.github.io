---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Projects — Karthikeshwar" currentPage="projects">
  <main class="page-content">
    <h1 class="page-title">Projects</h1>

    <section class="projects-section">
      <h2>Main Projects</h2>
      <div class="projects-grid">
        <article class="project-card">
          <h3><a href="https://kathaaverse.com/" target="_blank" rel="noopener">KathaaVerse</a></h3>
          <p class="project-desc">Turn any famous book into interactive fiction! Reached <strong>#1 on Hacker News</strong> — 20k visitors and 500k API calls in week one.</p>
          <span class="project-meta">Solo · June 2025</span>
        </article>
        <article class="project-card">
          <h3><a href="https://www.rxid.in/" target="_blank" rel="noopener">RxID</a></h3>
          <p class="project-desc">A prescription verification and dispensing-audit platform addressing 10+ pharma-related problems.</p>
          <span class="project-meta">Solo · May 2026</span>
        </article>
        <article class="project-card">
          <h3><a href="https://github.com/Karthikeshwar1/Araam" target="_blank" rel="noopener">Araam</a></h3>
          <p class="project-desc">Control your PC with just a controller!</p>
          <span class="project-meta">Solo · Aug 2021</span>
        </article>
        <article class="project-card">
          <h3><a href="https://github.com/Karthikeshwar1/airPiano" target="_blank" rel="noopener">airPiano</a></h3>
          <p class="project-desc">Play piano in the air, or play a bigger piano with the computer keyboard.</p>
          <span class="project-meta">Solo · Mar–Apr 2021</span>
        </article>
        <article class="project-card">
          <h3><a href="https://github.com/Karthikeshwar1/TABFYE" target="_blank" rel="noopener">TABFYE</a></h3>
          <p class="project-desc">Take-A-Break-For-Your-Eyes!</p>
          <span class="project-meta">Team of 4 · Jun 2020</span>
        </article>
      </div>
    </section>

    <section class="projects-section">
      <h2>Mini-projects</h2>
      <div class="projects-grid mini">
        <article class="project-card mini">
          <h3><a href="https://github.com/Karthikeshwar1/SwaGa-AutonomousLandingSystem" target="_blank" rel="noopener">SwaGa</a></h3>
          <p class="project-desc">Autonomous Landing Module Simulator</p>
        </article>
        <article class="project-card mini">
          <h3><a href="https://github.com/Karthikeshwar1/GRA" target="_blank" rel="noopener">GRA</a></h3>
          <p class="project-desc">Gesture Recognition Application</p>
        </article>
        <article class="project-card mini">
          <h3><a href="https://github.com/Karthikeshwar1/Puzzle" target="_blank" rel="noopener">Puzzle!</a></h3>
          <p class="project-desc">An elaborate puzzle game based on logic and GitHub knowledge!</p>
        </article>
        <article class="project-card mini">
          <h3><a href="https://github.com/Karthikeshwar1/JumpG" target="_blank" rel="noopener">JumpG</a></h3>
          <p class="project-desc">A Windows console game inspired from Google's T-rex game!</p>
        </article>
        <article class="project-card mini">
          <h3><a href="https://github.com/Karthikeshwar1/How-To-Write-Kannada" target="_blank" rel="noopener">Kannada Writing App</a></h3>
          <p class="project-desc">An app that shows how to write in Kannada</p>
        </article>
        <article class="project-card mini">
          <h3><a href="https://github.com/Karthikeshwar1/Medical_texts_3D_projection" target="_blank" rel="noopener">Medical Texts 3D</a></h3>
          <p class="project-desc">A 3D mapping/embedded projection of medical texts</p>
        </article>
        <article class="project-card mini">
          <h3><a href="https://github.com/Karthikeshwar1/screenRec" target="_blank" rel="noopener">screenRec</a></h3>
          <p class="project-desc">A screen recorder to take screenshots and record video</p>
        </article>
        <article class="project-card mini">
          <h3><a href="https://github.com/Karthikeshwar1/controller-vibration-tester" target="_blank" rel="noopener">Controller Vibration Tester</a></h3>
          <p class="project-desc">A python script to test vibration motors of game controllers</p>
        </article>
        <article class="project-card mini">
          <h3><a href="https://github.com/Karthikeshwar1/Wiki-Wordcloud-Maker" target="_blank" rel="noopener">Wiki-Wordcloud-Maker</a></h3>
          <p class="project-desc">Creates a wordcloud image from a Wikipedia article</p>
        </article>
        <article class="project-card mini">
          <h3><a href="https://github.com/Karthikeshwar1/Etcch-A-Sketch" target="_blank" rel="noopener">Etch-A-Sketch</a></h3>
          <p class="project-desc">Drawing app inspired from the popular toy</p>
        </article>
        <article class="project-card mini">
          <h3><a href="https://github.com/Karthikeshwar1/algorithms_visualization" target="_blank" rel="noopener">Algorithms Visualization</a></h3>
          <p class="project-desc">Visualizing algorithms using Processing 3</p>
        </article>
        <article class="project-card mini">
          <h3><a href="https://github.com/Karthikeshwar1/TheWitcher3HaircutPreview" target="_blank" rel="noopener">Witcher 3 Haircuts</a></h3>
          <p class="project-desc">Preview haircuts in The Witcher 3</p>
        </article>
        <article class="project-card mini">
          <h3><a href="https://github.com/Karthikeshwar1/ptzbak" target="_blank" rel="noopener">ptzbak!</a></h3>
          <p class="project-desc">ZskholHūkpl ksfpiwth ik faoOIFJO.</p>
        </article>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .page-content {
    flex: 1;
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 2rem;
  }

  .page-title {
    font-size: 1.6rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    margin-bottom: 2.5rem;
    color: var(--ink);
  }

  .projects-section {
    margin-bottom: 3rem;
  }

  .projects-section h2 {
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-secondary);
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .project-card {
    background: var(--paper);
    border: 1px solid var(--border-mat);
    padding: 1.25rem 1.5rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .project-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  }

  .project-card h3 {
    font-size: 1.05rem;
    font-weight: 400;
    margin-bottom: 0.5rem;
  }

  .project-card h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  .project-card h3 a:hover {
    color: var(--ink-secondary);
  }

  .project-desc {
    font-size: 0.9rem;
    color: var(--ink-secondary);
    line-height: 1.5;
  }

  .project-meta {
    font-size: 0.78rem;
    color: var(--ink-tertiary);
    letter-spacing: 0.08em;
    margin-top: 0.75rem;
    display: block;
  }

  .project-card.mini {
    padding: 1rem 1.25rem;
  }

  .project-card.mini h3 {
    font-size: 0.95rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .page-content {
      animation: fadeIn 0.8s ease-out 0.1s both;
    }
  }

  @media (max-width: 768px) {
    .page-content {
      padding: 2rem 1.25rem;
    }

    .page-title {
      font-size: 1.35rem;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
