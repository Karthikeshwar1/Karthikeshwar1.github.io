---
import BaseLayout from '../../layouts/BaseLayout.astro';
import T from '../../components/T.astro';
import { pageTitle, ui, type Text } from '../../lib/i18n';
import type { ImageMetadata } from 'astro';

import apcdIcon from '../../assets/projects/apcd.png';
import rxidIcon from '../../assets/projects/rxid.png';
import araamIcon from '../../assets/projects/araam.png';
import airpianoIcon from '../../assets/projects/airpiano.png';
import tabfyeIcon from '../../assets/projects/tabfye.png';
import swagaIcon from '../../assets/projects/swaga.png';
import jumpgIcon from '../../assets/projects/jumpg.png';
import kannadaIcon from '../../assets/projects/kannada.png';
import wikiIcon from '../../assets/projects/wiki.png';
import etchIcon from '../../assets/projects/etch.png';
import algorithmsIcon from '../../assets/projects/algorithms.png';
import witcherIcon from '../../assets/projects/witcher.png';

import kathaaverseInk from '../../assets/projects/kathaaverse.svg?raw';
import puzzleInk from '../../assets/projects/puzzle.svg?raw';
import graInk from '../../assets/projects/gra.svg?raw';
import medicalInk from '../../assets/projects/medical.svg?raw';
import screenrecInk from '../../assets/projects/screenrec.svg?raw';
import controllerInk from '../../assets/projects/controller.svg?raw';

type Mark = { img?: ImageMetadata; ink?: string; wide?: boolean };

const main: {
  name: string;
  href: string;
  where: string;
  meta: Text;
  description: Text;
  mark: Mark;
}[] = [
  {
    name: 'KathaaVerse',
    href: 'https://kathaaverse.com/',
    where: 'kathaaverse.com',
    meta: { en: 'Solo · June 2025', kn: 'ಏಕಾಂಗಿ · ಜೂನ್ 2025' },
    mark: { ink: kathaaverseInk },
    description: {
      en: 'Turn any famous book into interactive fiction! Reached <a href="https://github.com/Karthikeshwar1/Karthikeshwar1/blob/main/Hall%20of%20Fame/kathaaverse.md">#1 on Hacker News</a>, attracting more than 20k visitors and 500k API calls in the first week, despite no formal marketing.',
      kn: 'ಯಾವುದೇ ಪ್ರಸಿದ್ಧ ಪುಸ್ತಕವನ್ನು ಸಂವಾದಾತ್ಮಕ ಕಥೆಯಾಗಿಸಿ! ಯಾವುದೇ ಔಪಚಾರಿಕ ಪ್ರಚಾರವಿಲ್ಲದೆಯೂ <a href="https://github.com/Karthikeshwar1/Karthikeshwar1/blob/main/Hall%20of%20Fame/kathaaverse.md">Hacker News‌ನಲ್ಲಿ #1</a> ಸ್ಥಾನ ತಲುಪಿತು; ಮೊದಲ ವಾರದಲ್ಲೇ 20 ಸಾವಿರಕ್ಕೂ ಹೆಚ್ಚು ಸಂದರ್ಶಕರು ಮತ್ತು 5 ಲಕ್ಷ API ಕರೆಗಳು.',
    },
  },
  {
    name: 'APCD',
    href: 'https://karthikeshwar1.github.io/apcd-site/',
    where: 'karthikeshwar1.github.io/apcd-site',
    meta: { en: 'Solo · Oct 2026', kn: 'ಏಕಾಂಗಿ · ಅಕ್ಟೋಬರ್ 2026' },
    mark: { img: apcdIcon },
    description: {
      en: 'Concise project docs and a Progress list, so any new AI coding session picks up where you left off.',
      kn: 'ಸಂಕ್ಷಿಪ್ತ ಯೋಜನಾ ದಾಖಲೆಗಳು ಮತ್ತು ಒಂದು ಪ್ರಗತಿ ಪಟ್ಟಿ; ಹೊಸ AI ಕೋಡಿಂಗ್ ಸೆಷನ್ ನೀವು ಬಿಟ್ಟಿದ್ದ ಕಡೆಯಿಂದಲೇ ಮುಂದುವರಿಯುತ್ತದೆ.',
    },
  },
  {
    name: 'RxID',
    href: 'https://www.rxid.in/',
    where: 'rxid.in',
    meta: { en: 'Solo · May 2026', kn: 'ಏಕಾಂಗಿ · ಮೇ 2026' },
    mark: { img: rxidIcon },
    description: {
      en: 'A prescription verification and dispensing-audit platform, the only solution to address 10+ pharma-related problems.',
      kn: 'ಪ್ರಿಸ್ಕ್ರಿಪ್ಷನ್ ಪರಿಶೀಲನೆ ಮತ್ತು ಔಷಧ ವಿತರಣೆಯ ಲೆಕ್ಕಪರಿಶೋಧನೆಯ ವೇದಿಕೆ; ಔಷಧ ಕ್ಷೇತ್ರದ 10ಕ್ಕೂ ಹೆಚ್ಚು ಸಮಸ್ಯೆಗಳನ್ನು ಬಗೆಹರಿಸುವ ಏಕೈಕ ಪರಿಹಾರ.',
    },
  },
  {
    name: 'Araam',
    href: 'https://github.com/Karthikeshwar1/Araam',
    where: 'GitHub',
    meta: { en: 'Solo · Aug 2021', kn: 'ಏಕಾಂಗಿ · ಆಗಸ್ಟ್ 2021' },
    mark: { img: araamIcon },
    description: { en: 'Control your PC with just a controller!', kn: 'ಕೇವಲ ಒಂದು ಕಂಟ್ರೋಲರ್‌ನಿಂದ ನಿಮ್ಮ PC ನಿಯಂತ್ರಿಸಿ!' },
  },
  {
    name: 'airPiano',
    href: 'https://github.com/Karthikeshwar1/airPiano',
    where: 'GitHub',
    meta: { en: 'Solo · Mar–Apr 2021', kn: 'ಏಕಾಂಗಿ · ಮಾರ್ಚ್–ಏಪ್ರಿಲ್ 2021' },
    mark: { img: airpianoIcon },
    description: {
      en: 'A software with which you can play piano in the air, or play a bigger piano with the computer keyboard.',
      kn: 'ಗಾಳಿಯಲ್ಲೇ ಪಿಯಾನೋ ನುಡಿಸಲು, ಅಥವಾ ಕಂಪ್ಯೂಟರ್ ಕೀಬೋರ್ಡ್‌ನಲ್ಲಿ ದೊಡ್ಡ ಪಿಯಾನೋ ನುಡಿಸಲು ಒಂದು ತಂತ್ರಾಂಶ.',
    },
  },
  {
    name: 'TABFYE',
    href: 'https://github.com/Karthikeshwar1/TABFYE',
    where: 'GitHub',
    meta: { en: 'Team of 4 · Jun 2020', kn: '4 ಜನರ ತಂಡ · ಜೂನ್ 2020' },
    mark: { img: tabfyeIcon },
    description: { en: 'Take-A-Break-For-Your-Eyes!', kn: 'ಕಣ್ಣುಗಳಿಗೊಂದು ವಿರಾಮ ಕೊಡಿ!' },
  },
];

const mini: { name: string; href: string; description: Text; meta?: Text; mark: Mark }[] = [
  { repo: 'SwaGa-AutonomousLandingSystem', mark: { img: swagaIcon }, description: { en: 'Autonomous Landing Module Simulator', kn: 'ಸ್ವಯಂಚಾಲಿತ ಇಳಿಯುವ ಘಟಕದ ಸಿಮ್ಯುಲೇಟರ್' } },
  { repo: 'GRA', mark: { ink: graInk }, description: { en: 'Gesture Recognition Application (for RevaHack 2020)', kn: 'ಸನ್ನೆ ಗುರುತಿಸುವ ಅಪ್ಲಿಕೇಶನ್ (RevaHack 2020ಗಾಗಿ)' } },
  { repo: 'Puzzle', name: 'Puzzle!', mark: { ink: puzzleInk }, description: { en: 'An elaborate puzzle game based purely on logic and some GitHub knowledge!', kn: 'ಕೇವಲ ತರ್ಕ ಮತ್ತು ಸ್ವಲ್ಪ GitHub ಜ್ಞಾನ ಬೇಡುವ ವಿಸ್ತೃತ ಒಗಟಿನ ಆಟ!' } },
  {
    repo: 'JumpG',
    mark: { img: jumpgIcon, wide: true },
    description: { en: 'A Windows console game inspired from Google’s T-rex game!', kn: 'Googleನ T-rex ಆಟದಿಂದ ಪ್ರೇರಿತ Windows ಕನ್ಸೋಲ್ ಆಟ!' },
    meta: { en: 'Team of 2 · Apr–Jun 2019', kn: '2 ಜನರ ತಂಡ · ಏಪ್ರಿಲ್–ಜೂನ್ 2019' },
  },
  { repo: 'How-To-Write-Kannada', name: 'Kannada Writing App', mark: { img: kannadaIcon }, description: { en: 'An app that shows how to write in Kannada', kn: 'ಕನ್ನಡದಲ್ಲಿ ಹೇಗೆ ಬರೆಯುವುದೆಂದು ತೋರಿಸುವ ಆ್ಯಪ್' } },
  { repo: 'Medical_texts_3D_projection', name: 'Medical Texts 3D Projection', mark: { ink: medicalInk }, description: { en: 'A 3D mapping/embedded projection of medical texts', kn: 'ವೈದ್ಯಕೀಯ ಪಠ್ಯಗಳ 3D ನಕ್ಷೆ / ಎಂಬೆಡಿಂಗ್ ಪ್ರಕ್ಷೇಪಣ' } },
  { repo: 'screenRec', mark: { ink: screenrecInk }, description: { en: 'A screen recorder to take screenshots and record video', kn: 'ಸ್ಕ್ರೀನ್‌ಶಾಟ್ ತೆಗೆಯಲು ಮತ್ತು ವಿಡಿಯೋ ರೆಕಾರ್ಡ್ ಮಾಡಲು ಸ್ಕ್ರೀನ್ ರೆಕಾರ್ಡರ್' } },
  { repo: 'controller-vibration-tester', mark: { ink: controllerInk }, description: { en: 'A python script to test vibration motors of game controllers', kn: 'ಗೇಮ್ ಕಂಟ್ರೋಲರ್‌ಗಳ ಕಂಪನ ಮೋಟಾರ್‌ಗಳನ್ನು ಪರೀಕ್ಷಿಸುವ Python ಸ್ಕ್ರಿಪ್ಟ್' } },
  { repo: 'Wiki-Wordcloud-Maker', mark: { img: wikiIcon }, description: { en: 'Creates a wordcloud image based on a given Wikipedia article', kn: 'ಕೊಟ್ಟ ವಿಕಿಪೀಡಿಯ ಲೇಖನದಿಂದ ವರ್ಡ್‌ಕ್ಲೌಡ್ ಚಿತ್ರ ರಚಿಸುತ್ತದೆ' } },
  { repo: 'Etcch-A-Sketch', mark: { img: etchIcon }, description: { en: 'Drawing app inspired from the popular toy Etch A Sketch', kn: 'ಜನಪ್ರಿಯ ಆಟಿಕೆ Etch A Sketchನಿಂದ ಪ್ರೇರಿತ ಚಿತ್ರ ಬಿಡಿಸುವ ಆ್ಯಪ್' } },
  { repo: 'algorithms_visualization', mark: { img: algorithmsIcon }, description: { en: 'Visualizing algorithms using Processing 3', kn: 'Processing 3 ಬಳಸಿ ಅಲ್ಗಾರಿದಮ್‌ಗಳ ದೃಶ್ಯೀಕರಣ' } },
  { repo: 'TheWitcher3HaircutPreview', name: 'The Witcher 3 Haircut Preview', mark: { img: witcherIcon }, description: { en: 'Preview haircuts in the game The Witcher 3', kn: 'The Witcher 3 ಆಟದಲ್ಲಿ ಕೇಶವಿನ್ಯಾಸಗಳ ಮುನ್ನೋಟ' } },
].map(({ repo, name, description, meta, mark }) => ({
  name: name ?? repo,
  href: `https://github.com/Karthikeshwar1/${repo}`,
  description,
  meta,
  mark,
}));
---

<BaseLayout
  title={pageTitle(ui.nav.projects)}
  headTitle={ui.nav.projects}
  description="Things Karthikeshwar has built, from KathaaVerse (#1 on Hacker News) and RxID to small experiments."
  currentPage="projects"
>
  <main id="main" class="archive" tabindex="-1">
    <aside class="archive-aside">
      <h1 class="archive-title"><T t={ui.nav.projects} /></h1>
      <div class="archive-count">
        <p class="label"><T t={ui.projects.count(main.length, mini.length)} /></p>
      </div>
    </aside>

    <div class="archive-body">
      <section class="archive-section" aria-labelledby="main-heading">
        <h2 class="section-heading" id="main-heading"><T t={ui.projects.main} /></h2>
        <ul class="ledger">
          {main.map((p) => (
            <li class="project">
              <div class="project-head">
                <h3 class="project-name">
                  <a href={p.href}>
                    {p.mark.ink ? (
                      <span class="mark" aria-hidden="true" set:html={p.mark.ink} />
                    ) : (
                      <img class="mark" src={p.mark.img!.src} width="20" height="20" alt="" />
                    )}
                    <span class="name">{p.name}</span>
                  </a>
                </h3>
                <span class="ledger-meta"><T t={p.meta} /></span>
              </div>
              <p class="project-desc"><T t={p.description} html /></p>
              <a class="project-where label" href={p.href} tabindex="-1" aria-hidden="true">{p.where}</a>
            </li>
          ))}
        </ul>
      </section>

      <section class="archive-section" aria-labelledby="mini-heading">
        <h2 class="section-heading" id="mini-heading"><T t={ui.projects.mini} /></h2>
        <ul class="ledger">
          {mini.map((p) => (
            <li>
              <a class="mini" href={p.href}>
                <span class="mini-id">
                  {p.mark.ink ? (
                    <span class:list={['mark', { wide: p.mark.wide }]} aria-hidden="true" set:html={p.mark.ink} />
                  ) : (
                    <img
                      class:list={['mark', { wide: p.mark.wide }]}
                      src={p.mark.img!.src}
                      width={p.mark.wide ? 40 : 16}
                      height="16"
                      alt=""
                    />
                  )}
                  <span class="ledger-title">{p.name}</span>
                </span>
                <span class="mini-desc">
                  <T t={p.description} />
                  {p.meta && <span class="mini-meta label"><T t={p.meta} /></span>}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .github {
    align-self: flex-start;
    color: var(--ink-secondary);
    text-decoration: underline;
    text-decoration-color: var(--border-subtle);
    text-underline-offset: 0.35em;
  }

  .github:hover {
    color: var(--ink);
    text-decoration-color: currentColor;
  }

  /* The project's own mark, about the cap-height of the title.
     Colour stays inside the picture. Ink drawings follow the type. */
  .mark {
    display: inline-block;
    width: 1.25rem;
    height: 1.25rem;
    margin-right: 0.42rem;
    vertical-align: -0.18em;
    object-fit: contain;
    object-position: center;
  }

  .mark :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* ── Main projects ──────────────────────────────────── */

  .project {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.6rem 0 1.5rem;
  }

  .project-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .project-name {
    font-size: 1.6rem;
    font-weight: 400;
    line-height: 1.2;
  }

  .project-name a {
    color: var(--ink);
    text-decoration: none;
  }

  .project-name .name {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .project-name a:hover .name {
    text-decoration-color: currentColor;
  }

  .project-desc {
    max-width: 36rem;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--ink-secondary);
    text-wrap: pretty;
  }

  .project-desc :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--underline);
    text-underline-offset: 0.22em;
  }

  .project-desc :global(a:hover) {
    text-decoration-color: currentColor;
  }

  .project-where {
    align-self: flex-start;
    margin-top: 0.2rem;
    text-transform: none;
    letter-spacing: 0.06em;
    font-size: 0.8rem;
  }

  .project-where:hover {
    color: var(--ink);
  }

  /* ── Mini-projects ──────────────────────────────────── */

  .mini {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: 0.25rem 2rem;
    align-items: baseline;
    padding: 0.85rem 0;
  }

  .mini-id {
    min-width: 0;
    color: var(--ink-secondary);
  }

  .mini .mark {
    width: 1rem;
    height: 1rem;
    margin-right: 0.38rem;
    vertical-align: -0.14em;
  }

  .mini .mark.wide {
    width: auto;
    max-width: 2.6rem;
    height: 0.9rem;
    vertical-align: -0.08em;
  }

  .mini .ledger-title {
    font-size: var(--type-h4);
    overflow-wrap: anywhere;
  }

  .mini:hover .mini-id,
  .mini:hover .ledger-title {
    color: var(--ink);
  }

  .mini:hover .ledger-title {
    text-decoration-color: currentColor;
  }

  .mini-desc {
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--ink-tertiary);
    text-wrap: pretty;
  }

  .mini-meta {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--type-label);
  }

  @media (max-width: 600px) {
    .github {
      align-self: center;
    }
  }

  @media (max-width: 768px) {
    .project-head {
      flex-direction: column;
      gap: 0.3rem;
    }

    .project-name {
      font-size: 1.4rem;
    }

    .mark {
      width: 1.15rem;
      height: 1.15rem;
    }

    .mini {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
